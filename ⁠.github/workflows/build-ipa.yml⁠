name: Build TrollStore GPS IPA

on:
  push:
    branches: [ "*" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-14

    steps:
    - name: Checkout Source Code
      uses: actions/checkout@v4

    - name: Set up Theos Environment
      run: |
        git clone --recursive https://github.com/theos/theos.git /Users/runner/theos
        echo "THEOS=/Users/runner/theos" >> $GITHUB_ENV

    # THAY ĐỔI QUAN TRỌNG: Ép hệ thống dùng lệnh giải nén tar trên file nén chuẩn của sdks-master
    - name: Download iOS SDK
      run: |
        mkdir -p /Users/runner/theos/sdks
        # Sử dụng link tải zip trực tiếp từ nhánh master của kho lưu trữ sdks chính thức
        curl -L "https://codeload.github.com/theos/sdks/zip/refs/heads/master" -o sdks.zip
        
        # Tiến hành giải nén gói cấu hình zip hệ thống
        unzip -q sdks.zip -d /Users/runner/work/
        
        # Di chuyển bộ SDK vào đúng vị trí biên dịch của Theos
        cp -r /Users/runner/work/sdks-master/iPhoneOS16.5.sdk /Users/runner/theos/sdks/
        
        # Dọn dẹp bộ nhớ đệm máy ảo
        rm -rf sdks.zip /Users/runner/work/sdks-master

    - name: Compile Application to IPA
      run: |
        make package FINALPACKAGE=1 THEOS=/Users/runner/theos
        mkdir -p Payload
        cp -r .theos/obj/OmniGPS.app Payload/
        zip -r OmniGPS_TrollStore.ipa Payload

    - name: Upload Finished IPA
      uses: actions/upload-artifact@v4
      with:
        name: OmniGPS-TrollStore-Edition
        path: OmniGPS_TrollStore.ipa
